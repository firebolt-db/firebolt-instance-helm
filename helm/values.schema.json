{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "firebolt-instance values",
  "description": "Validates the genuine configuration surface of the chart. Security-context fields are intentionally not constrained here: they are hardcoded in the templates as a security floor, not a user-tunable. The schema is permissive (additionalProperties is left at its default) so unknown keys pass and the chart stays forward-compatible.",
  "type": "object",
  "properties": {
    "createNamespace": {
      "type": "boolean"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "engineSpec": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "uiSidecarImage": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "storageType": {
          "type": "string",
          "enum": [
            "pvc",
            "emptyDir",
            "hostPath"
          ]
        },
        "emptyDir": {
          "type": "object",
          "properties": {
            "medium": {
              "type": "string",
              "enum": [
                "",
                "Memory"
              ]
            },
            "sizeLimit": {
              "type": "string"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 6
        },
        "readiness": {
          "type": "boolean"
        },
        "uiSidecar": {
          "type": "boolean"
        },
        "serviceAccount": {
          "type": "string"
        },
        "hostPathStorageEnabled": {
          "type": "boolean"
        },
        "memlockSetup": {
          "type": "boolean"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "defaultStorage": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "customVolumes": {
          "type": "array"
        },
        "customVolumeMounts": {
          "type": "array"
        },
        "customInitContainersTemplate": {
          "type": "array"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "server": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.:\\[\\]-]*$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "threads": {
              "type": "integer",
              "minimum": 0
            },
            "log_level": {
              "type": "string",
              "pattern": "^[A-Za-z]+$"
            }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "local_enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.:\\[\\]-]*$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "caSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ]
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "admin": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "object",
                  "properties": {
                    "secretRef": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "signingKeys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/secretSourceKeyed"
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "gateway": {
          "$ref": "#/definitions/secretSource"
        },
        "engine": {
          "$ref": "#/definitions/secretSource"
        }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "customEngineConfig": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "object"
              }
            }
          },
          "storage": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "replicas"
        ],
        "allOf": [
          {
            "$ref": "#/definitions/engineOverrides"
          }
        ]
      }
    },
    "customEngineConfig": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
            }
          }
        }
      }
    },
    "podMonitor": {
      "type": "object",
      "properties": {
        "engines": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "certManagerSource": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "RSA",
            "ECDSA"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "dnsNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issuerRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            }
          }
        }
      }
    },
    "secretSource": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "object",
          "properties": {
            "secretRef": {
              "type": "string"
            }
          }
        },
        "certManager": {
          "$ref": "#/definitions/certManagerSource"
        },
        "verification": {
          "type": "object",
          "properties": {
            "serverName": {
              "type": "string",
              "pattern": "^([A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)?$"
            },
            "caSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "secretSourceKeyed": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "object",
          "properties": {
            "secretRef": {
              "type": "string"
            }
          }
        },
        "certManager": {
          "$ref": "#/definitions/certManagerSource"
        }
      },
      "required": [
        "id"
      ]
    },
    "engineOverrides": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "uiSidecarImage": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never",
                "IfNotPresent"
              ]
            }
          }
        },
        "storageType": {
          "type": "string",
          "enum": [
            "pvc",
            "emptyDir",
            "hostPath"
          ]
        },
        "emptyDir": {
          "type": "object",
          "properties": {
            "medium": {
              "type": "string",
              "enum": [
                "",
                "Memory"
              ]
            },
            "sizeLimit": {
              "type": "string"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 6
        },
        "readiness": {
          "type": "boolean"
        },
        "uiSidecar": {
          "type": "boolean"
        },
        "serviceAccount": {
          "type": "string"
        },
        "hostPathStorageEnabled": {
          "type": "boolean"
        },
        "memlockSetup": {
          "type": "boolean"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "customVolumes": {
          "type": "array"
        },
        "customVolumeMounts": {
          "type": "array"
        },
        "customInitContainersTemplate": {
          "type": "array"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
